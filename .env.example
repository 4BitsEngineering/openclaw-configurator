# OpenClaw Configurator - Environment Variables

# Application
NEXT_PUBLIC_APP_NAME=OpenClaw Configurator
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration (if needed)
# NEXT_PUBLIC_API_URL=https://api.example.com

# clawhub (control plane) — necesarias para el step "Registro".
# El servidor del configurator llama a POST {CLAWHUB_URL}/api/v0/register con
# OPERATOR_API_KEY (M2M, secreto de SERVIDOR — nunca NEXT_PUBLIC_, no viaja al
# navegador). Misma key que clawhub usa para /api/v0/bundles/register.
CLAWHUB_URL=https://clawhub-three.vercel.app
OPERATOR_API_KEY=
# Gate de acceso del step Registro (deploys PÚBLICOS): si se define, /api/register
# exige la cabecera x-configurator-token con este valor (el wizard pide la
# contraseña al usuario). Es lo que protege el endpoint que hace de proxy de la
# operator key cuando la app es pública. Déjala vacía solo en local.
CONFIGURATOR_ACCESS_TOKEN=

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace placeholders with your actual values
# 3. Never commit .env.local to git (already in .gitignore)
